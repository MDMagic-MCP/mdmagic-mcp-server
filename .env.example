# MDMagic MCP Server Configuration

# Required: Your personal MDMagic API key
# Get this from your MDMagic dashboard: https://mdmagic.ai/dashboard
MDMAGIC_API_KEY=mdmagic-1234567890123456

# Optional: MDMagic API base URL (defaults to https://api.mdmagic.ai)
# Override only if running against a local dev backend or staging.
# MDMAGIC_BASE_URL=https://api.mdmagic.ai

# Optional: Request timeout in milliseconds (defaults to 30000)
# REQUEST_TIMEOUT=30000

# Optional: Transport mode — "stdio" (default) or "http".
# Most users should leave this unset. HTTP mode is for self-hosted scenarios.
# MCP_TRANSPORT=stdio
# MCP_HTTP_PORT=3001
# MCP_HTTP_HOST=127.0.0.1
