{
  "name": "@mdmagic/mcp-server",
  "version": "1.7.13",
  "mcpName": "io.github.MDMagic-MCP/mdmagic-mcp-server",
  "description": "Model Context Protocol server for MDMagic — convert Markdown to professional DOCX, PDF, and HTML using MDMagic templates.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "mdmagic-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "nodemon --exec ts-node --esm src/index.ts",
    "start": "node build/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node ./build/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mdmagic",
    "document-conversion",
    "markdown",
    "pdf",
    "docx",
    "html",
    "claude",
    "anthropic"
  ],
  "author": "MDMagic",
  "license": "MIT",
  "homepage": "https://mdmagic.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDMagic-MCP/mdmagic-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/MDMagic-MCP/mdmagic-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^5.2.1",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
